# Set APP_ENV to development, staging, or production.
# Existing deployments can omit it; NODE_ENV continues to control Node behavior.
APP_ENV=staging
NODE_ENV=production

# Override this on staging if its Tally API has a different public URL.
# If omitted, the existing production URL is used.
TALLY_BASE_URL=https://erpv2.camet.in/api/tally/
